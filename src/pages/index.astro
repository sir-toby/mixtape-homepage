---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cassette from '../components/Cassette.astro';
import TapeReels from '../components/TapeReels.astro';
import CalendarSubscribe from '../components/CalendarSubscribe.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import NextEvent from '../components/NextEvent.astro';
import EventTrack from '../components/EventTrack.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import TapeCounter from '../components/TapeCounter.astro';
import VuMeter from '../components/VuMeter.astro';
import groupCutout from '../assets/brand/group-cutout-wide.png';
import livePhoto from '../assets/photos/bardentreffen-2026-stage.jpg';
import settings from '../data/settings.json';
import { getHomeData } from '../lib/home-data';
import { url } from '../lib/url';

const { home, newsletter, upcoming, past, members } = await getHomeData();
const { Content: Welcome } = await render(home);
const { Content: NewsletterIntro } = await render(newsletter);
const [next, ...later] = upcoming;

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const headline = esc(home.data.tagline ?? '')
  .replace(/(A-cappella-)/, '<span class="nw">$1</span>')
  .replace('Spaß', '<mark>Spaß</mark>');
---

<Base description={home.data.description}>
  <section class="hero">
    <div class="wrap hero-grid">
      {home.data.kicker && <span class="label hero-label">{home.data.kicker}</span>}
      <h1 class="hero-title" set:html={headline} />
      {home.data.lead && <p class="lead">{home.data.lead}</p>}
      <div class="hero-cta">
        <a class="btn btn--orange" href="#termine"><Icon name="play" size={16} /> Nächste Termine</a>
        <a class="btn btn--ghost rec" href={`mailto:${settings.email}`}><Icon name="rec" size={14} /> Mixtape buchen</a>
      </div>
      <div class="hero-visual">
        <TapeReels class="bg-tape" />
        <Image
          src={groupCutout}
          alt="Die Mitglieder von Mixtape sitzen lachend auf dem Boden, mit Kassetten und einem großen M"
          widths={[640, 960, 1491]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
          fetchpriority="high"
          class="cutout"
        />
      </div>
    </div>
  </section>

  <div class="stripe-band" aria-hidden="true"></div>
  <Marquee items={['A cappella', ...settings.genres, 'Live']} />

  <section id="termine" class="section">
    <div class="wrap">
      <header class="section-head">
        <h2>{home.data.eventsHeading}</h2>
      </header>
      {next && <NextEvent event={next} />}
      {
        later.length > 0 && (
          <ol class="tracklist">
            {later.map((e) => (
              <EventTrack event={e} />
            ))}
          </ol>
        )
      }
      <a class="more" href={url('/events/')}>
        Alle Termine · <TapeCounter value={past.length} /> bisherige Auftritte <Icon name="arrow" size={18} />
      </a>
      <div class="subscribe-row"><CalendarSubscribe compact /></div>
    </div>
  </section>

  <section class="section welcome surface-2">
    <div class="wrap welcome-grid">
      <div class="jcard">
        <div class="jcard-spine">
          <span class="marker">Mixtape</span>
          <span class="mono">Vol. 01</span>
        </div>
        <div class="jcard-body">
          <div class="jcard-head mono"><span>Liner Notes</span><span>Seit 2022</span></div>
          <h2>{home.data.heading}</h2>
          <div class="prose"><Welcome /></div>
        </div>
      </div>
      <figure class="polaroid">
        <span class="washi w1" aria-hidden="true"></span>
        <span class="washi w2" aria-hidden="true"></span>
        <Image src={livePhoto} alt="Mixtape singt live auf einer Treppe in der Nürnberger Altstadt" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 40vw" />
        {home.data.photoCaption && <figcaption class="marker">{home.data.photoCaption}</figcaption>}
      </figure>
    </div>
  </section>

  <section class="section band tinted on-bright">
    <div class="wrap">
      <header class="section-head">
        <h2>{home.data.bandHeading}</h2>
        {home.data.bandIntro && <p class="intro">{home.data.bandIntro}</p>}
      </header>
      <ul class="inserts">
        {
          members.map((m, i) => (
            <li style={`--i:${i}`}>
              <a href={url(`/wer-wir-sind/#${m.id}`)}>
                <span class="spine">
                  <span class="marker">{m.data.name}</span>
                  <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                </span>
                <span class="front">
                  <span class="front-top mono">
                    <span>Mixtape</span>
                    <span>Track {String(i + 1).padStart(2, '0')}</span>
                  </span>
                  <span class="photo">
                    <Image src={m.data.photo} alt={m.data.photoAlt ?? m.data.name} widths={[320, 640]} sizes="(max-width: 640px) 45vw, 22vw" />
                  </span>
                  <span class="front-bottom">
                    <span class="name marker">{m.data.name}</span>
                    <span class="voice mono">{m.data.voice}</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="center">
        <a class="btn" href={url('/wer-wir-sind/')}><Icon name="play" size={16} /> Mehr über uns</a>
      </div>
    </div>
  </section>

  <section class="booking tinted on-bright">
    <div class="wrap booking-grid">
      
      <div class="booking-tape">
        <Cassette shell="#ffffff" label="var(--ink)" side="B" type="C90">
          <span class="light-writing">Eure Feier</span>
        </Cassette>
      </div>
      <div>
        <span class="rec-light mono"><span class="dot"></span> Rec</span>
        <h2>{home.data.bookingHeading}</h2>
        <p class="booking-text">{home.data.bookingText}</p>
        <a class="btn" href={`mailto:${settings.email}`}><Icon name="mail" size={18} /> {home.data.bookingButton}</a>
      </div>
    </div>
  </section>

  <section class="section deck">
    <div class="wrap deck-grid">
      <div>
        <span class="label">Newsletter</span>
        <h2>{home.data.newsletterHeading}</h2>
        <VuMeter />
      </div>
      <div>
        <div class="nl-intro"><NewsletterIntro /></div>
        <NewsletterForm />
        <p class="insta">
          Oder folgt uns auf <a href={settings.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> Instagram</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .section {
    padding-block: clamp(4rem, 9vw, 7.5rem);
    overflow-x: clip;
  }
  .section-head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .section-head h2 {
    font-size: clamp(3.5rem, 2rem + 7vw, 8rem);
    margin-top: 0.25rem;
  }
  .intro {
    font-size: 1.25rem;
    margin-top: 0.75rem;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-rows: 1fr auto auto auto auto 1fr;
    grid-template-areas:
      '. visual'
      'label visual'
      'title visual'
      'lead visual'
      'cta visual'
      '. visual';
    column-gap: 2rem;
  }
  .hero-label {
    grid-area: label;
  }
  .hero-title {
    grid-area: title;
    font-size: clamp(3.4rem, 1.6rem + 5.6vw, 7rem);
    line-height: 1;
    margin: 1.25rem 0 1.5rem;
  }
  .hero-title :global(.nw) {
    white-space: nowrap;
  }
  .hero-title :global(mark) {
    background: none;
    color: var(--orange);
    position: relative;
    white-space: nowrap;
  }
  .hero-title :global(mark)::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    bottom: 0.06em;
    height: 0.14em;
    background: var(--cyan);
    border-radius: 99px;
    z-index: -1;
  }
  .lead {
    grid-area: lead;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    max-width: 30ch;
    color: var(--ink-soft);
  }
  .hero-cta {
    grid-area: cta;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .rec :global(svg) {
    color: var(--orange);
  }
  .hero-visual {
    grid-area: visual;
    position: relative;
    aspect-ratio: 1491 / 1060;
    align-self: center;
  }
  .hero-visual :global(.bg-tape) {
    position: absolute;
    left: -4%;
    top: 0;
    width: 108%;
  }
  .cutout {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 24px #16171b33);
  }

  /* Events */
  .tracklist {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .more {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
    font-weight: 700;
    text-decoration: none;
  }
  .more:hover {
    color: var(--orange-deep);
  }
  .subscribe-row {
    margin-top: 1.25rem;
  }

  /* Welcome */
  .welcome-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .jcard {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    background: var(--card);
    border: 2px solid var(--edge);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 10px 10px 0 var(--edge);
  }
  .jcard-spine {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    background: linear-gradient(to left, var(--orange) 0 33%, var(--cyan) 33% 66%, var(--dark) 66%);
    color: #fff;
    border-left: 2px solid var(--edge);
  }
  .jcard-spine .marker {
    font-size: 1.4rem;
  }
  .jcard-spine .mono {
    font-size: 0.7rem;
  }
  .jcard-body {
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .jcard-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--ink-soft);
    border-bottom: 2px solid var(--edge);
    padding-bottom: 0.6rem;
    margin-bottom: 1.5rem;
  }
  .jcard h2 {
    font-size: clamp(2.2rem, 1.5rem + 2.5vw, 3.5rem);
    margin-bottom: 1.25rem;
  }
  .polaroid {
    position: relative;
    margin: 0;
    background: var(--photo-frame);
    color: #16171b;
    padding: 0.9rem 0.9rem 0;
    box-shadow: 0 18px 40px -16px #16171b55;
    transform: rotate(2.5deg);
  }
  .polaroid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .polaroid figcaption {
    font-size: 1.15rem;
    padding: 0.8rem 0.25rem 1rem;
    text-align: center;
  }
  .washi {
    position: absolute;
    z-index: 1;
    width: 110px;
    height: 30px;
    opacity: 0.85;
    background: repeating-linear-gradient(45deg, var(--cyan) 0 8px, #6fd9e5 8px 16px);
  }
  .w1 {
    top: -12px;
    left: -24px;
    transform: rotate(-30deg);
  }
  .w2 {
    top: -12px;
    right: -24px;
    transform: rotate(28deg);
    background: repeating-linear-gradient(45deg, var(--orange) 0 8px, #ff8c62 8px 16px);
  }

  /* Band: J-card inserts */
  .band {
    background-color: var(--cyan);
  }
  .inserts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  .inserts li:nth-child(odd) a {
    transform: rotate(-1.5deg);
  }
  .inserts li:nth-child(even) a {
    transform: rotate(1.5deg) translateY(12px);
  }
  .inserts a {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    text-decoration: none;
    border: 2px solid var(--edge);
    border-radius: 4px;
    overflow: hidden;
    background: var(--card);
    box-shadow: 6px 6px 0 var(--edge);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.3s;
  }
  .inserts a:hover {
    transform: translateY(-10px) rotate(0deg);
    box-shadow: 10px 14px 0 var(--edge);
  }
  .spine {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    background: var(--dark);
    color: #fff;
  }
  .spine .marker {
    font-size: 1.25rem;
  }
  .spine .mono {
    font-size: 0.65rem;
    color: var(--cyan);
  }
  .inserts li:nth-child(even) .spine .mono {
    color: var(--orange);
  }
  .front {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .front-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 2px solid var(--edge);
  }
  .photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-bottom: 2px solid var(--edge);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .inserts a:hover .photo img {
    transform: scale(1.05);
  }
  .front-bottom {
    display: grid;
    padding: 0.6rem 0.7rem 0.8rem;
    background: linear-gradient(to bottom, transparent 0 calc(100% - 12px), var(--orange) calc(100% - 12px) calc(100% - 6px), var(--cyan) calc(100% - 6px));
  }
  .name {
    font-size: clamp(1.4rem, 1.1rem + 0.8vw, 1.9rem);
    line-height: 1.1;
  }
  .voice {
    font-size: 0.62rem;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .center {
    display: flex;
    justify-content: center;
    margin-top: 3.5rem;
  }

  /* Booking */
  .booking {
    background-color: var(--orange);
    color: #fff;
    padding-block: clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }
  .booking-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 4rem;
    align-items: center;
  }
  .rec-light {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--dark);
    color: #fff;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
  }
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff2d2d;
    animation: blink 1.2s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.15;
    }
  }
  .booking h2 {
    font-size: clamp(3.2rem, 2rem + 5vw, 6.5rem);
    margin: 1rem 0 1.25rem;
    color: var(--ink);
  }
  .booking-text {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    margin-bottom: 1.75rem;
  }
  .booking-tape {
    transform: rotate(8deg);
  }
  .light-writing {
    color: #fff;
  }
  .booking-tape :global(.writing) {
    border-color: #ffffff55;
  }
  .booking-tape :global(.side) {
    background: var(--orange);
  }
  .booking-tape :global(.type) {
    color: #ffffffaa;
  }

  /* Newsletter as tape deck */
  .deck {
    background: var(--deck);
    color: #f1f1f1;
  }
  .deck-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 4rem;
    align-items: center;
  }
  .deck h2 {
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    margin: 0.75rem 0 1.5rem;
  }
  .nl-intro {
    color: #c9ccd2;
    margin-bottom: 1.5rem;
  }
  .insta {
    margin-top: 1.25rem;
    font-size: 0.95rem;
  }
  .insta a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 700;
    vertical-align: bottom;
  }

  @media (max-width: 900px) {
    /* Phone: picture and headline first, then the buttons */
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas: 'label' 'visual' 'title' 'lead' 'cta';
    }
    .hero-visual {
      margin-top: 1rem;
    }
    .hero-title {
      margin-top: 0.5rem;
    }
    .welcome-grid,
    .booking-grid,
    .deck-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .inserts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .polaroid {
      max-width: 480px;
      margin-inline: auto;
    }
    .booking-tape {
      max-width: 420px;
    }
  }
</style>
