---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../lib/url';

const variants = [
  {
    key: 'A',
    name: 'Kassette',
    href: url('/'),
    text: 'Hell, verspielt, Retro trifft modern: Creme-Papier, die Logofarben Cyan und Orange, kondensierte Plakatschrift, Termine als Tracklist und Side A / Side B. Das ist die aktuell ausgebaute Variante – alle Unterseiten nutzen sie.',
    tone: 'var(--cyan)',
  },
  {
    key: 'A2',
    name: 'Kassette 2',
    href: url('/prototypen/a2/'),
    text: 'Wie A, aber Weiß statt Creme und mehr Kassetten-Stil: drehende Spulen wie im Logo, Kassette als dezente Form im Hintergrund, Mitglieder als Kassetten-Cover, Retro-Streifen, Play/Rec-Knöpfe, Bandzählwerk, REC-Lampe und VU-Meter.',
    tone: 'var(--ink)',
  },
  {
    key: 'B',
    name: 'Bühne',
    href: url('/prototypen/b/'),
    text: 'Dunkel wie ein Konzertsaal, farbige Lichtkegel, Glas-Karten und breite Schrift. Wirkt wie ein Festival-Lineup und lässt die Fotos leuchten.',
    tone: 'var(--ink)',
  },
  {
    key: 'C',
    name: 'Editorial',
    href: url('/prototypen/c/'),
    text: 'Ruhig und hochwertig wie ein Magazin: großes Live-Foto, Serifenschrift, viel Weißraum, Farbe nur als Akzent.',
    tone: 'var(--orange)',
  },
];
---

<Base title="Design-Prototypen" noindex>
  <PageHero label="Work in progress" title="Prototypen" intro="Drei Richtungen für die neue Mixtape-Seite. Alle nutzen dieselben Inhalte aus dem CMS." />
  <section class="wrap list">
    {
      variants.map((v) => (
        <a class="variant" href={v.href} style={`--tone:${v.tone}`}>
          <span class="key">{v.key}</span>
          <span class="body">
            <span class="name">{v.name}</span>
            <span class="text">{v.text}</span>
          </span>
          <Icon name="arrow" size={28} />
        </a>
      ))
    }
  </section>
</Base>

<style>
  .list {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    gap: 1.25rem;
  }
  .variant {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .variant:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--tone);
  }
  .key {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--tone);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2rem;
  }
  .name {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.2rem;
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .text {
    color: var(--ink-soft);
  }
  @media (max-width: 600px) {
    .variant {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .variant > :global(svg) {
      display: none;
    }
  }
</style>
