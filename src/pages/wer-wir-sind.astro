---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import TapeReels from '../components/TapeReels.astro';
import { url } from '../lib/url';
import groupCutout from '../assets/brand/group-cutout-wide.png';
import groupPhoto from '../assets/photos/group-cassette.jpg';

const page = (await getEntry('pages', 'wer-wir-sind'))!;
const { Content } = await render(page);
const all = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order);
const withContent = await Promise.all(all.map(async (m) => ({ m, Content: (await render(m)).Content })));
const current = withContent.filter(({ m }) => !m.data.former);
const former = withContent.filter(({ m }) => m.data.former);
---

<Base title={page.data.title} description={page.data.description}>
  <PageHero label="Liner Notes" title={page.data.title} tone="orange" />

  <section class="intro-section">
    <div class="wrap intro-grid">
      <div class="prose lead" data-reveal><Content /></div>
      <div class="cutout-wrap" data-reveal>
        <TapeReels class="bg-tape" />
        <Image src={groupCutout} alt="Mixtape: Andreas, Carina, Ellen und Tobias sitzen lachend auf dem Boden" widths={[640, 960, 1491]} sizes="(max-width: 900px) 100vw, 50vw" />
      </div>
    </div>
  </section>

  <section class="members-section surface-2">
    <div class="wrap">
      <span class="side-tag" data-reveal>Side A</span>
      <h2 class="sub" data-reveal>Die Stimmen</h2>
      <div class="members">
        {
          current.map(({ m, Content }, i) => (
            <article class:list={['member', i % 2 ? 'orange' : 'cyan']} id={m.id} data-reveal>
              <div class="spine" aria-hidden="true">
                <span class="marker">{m.data.name}</span>
                <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="photo">
                <Image src={m.data.photo} alt={m.data.photoAlt ?? m.data.name} widths={[400, 700]} sizes="(max-width: 760px) 100vw, 320px" />
              </div>
              <div class="text">
                <span class="side mono">Track {String(i + 1).padStart(2, '0')}</span>
                <h3>{m.data.name}</h3>
                <span class="voice mono">{m.data.voice}</span>
                <div class="prose"><Content /></div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    page.data.lineup && (
      <section class="lineup-section">
        <div class="wrap">
          <h2 class="sub" data-reveal>Besetzung</h2>
          <ol class="lineup" data-reveal>
            {page.data.lineup.map((l) => (
              <li>
                <span class="period">{l.period}</span>
                <span class="names">{l.names}</span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    former.length > 0 && (
      <section class="former-section surface-2">
        <div class="wrap">
          <span class="side-tag" data-reveal>Side B</span>
          <h2 class="sub" data-reveal>Ehemalige Mitglieder</h2>
          <div class="former">
            {former.map(({ m, Content }) => (
              <article class="member small" id={m.id} data-reveal>
                <div class="photo grey">
                  <Image src={m.data.photo} alt={m.data.photoAlt ?? m.data.name} widths={[300, 600]} sizes="200px" />
                </div>
                <div class="text">
                  <h3>{m.data.name}</h3>
                  <div class="prose"><Content /></div>
                </div>
              </article>
            ))}
          </div>
          <figure class="old-photo" data-reveal>
            <Image src={groupPhoto} alt="Mixtape in der Besetzung 2024–2026 schaut staunend auf eine Kassette" widths={[640, 1000, 1600]} sizes="(max-width: 1200px) 100vw, 1100px" />
            <figcaption class="mono">Besetzung 2024–2026</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="cta-section">
    <div class="wrap cta">
      <h2>Live erleben</h2>
      <div class="cta-buttons">
        <a class="btn btn--orange" href={url('/events/')}><Icon name="play" size={16} /> Zu den Terminen</a>
        <a class="btn btn--cyan" href="mailto:info@mixtape-vocal.de"><Icon name="rec" size={12} /> Mixtape buchen</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .sub {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 5rem);
    margin: 0.25rem 0 clamp(2rem, 4vw, 3rem);
  }
  .intro-section {
    padding-block: clamp(3rem, 7vw, 6rem);
    overflow-x: clip;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .lead {
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
  }
  .lead :global(p:last-child) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.2rem;
    text-transform: uppercase;
    color: var(--orange);
    line-height: 1;
    margin-top: 1.5rem;
  }
  .cutout-wrap {
    position: relative;
    padding-top: 22%;
  }
  .cutout-wrap :global(.bg-tape) {
    position: absolute;
    left: -4%;
    top: 0;
    width: 108%;
  }
  .cutout-wrap img {
    position: relative;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 24px #16171b33);
  }

  .members-section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .members {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .member {
    display: grid;
    grid-template-columns: 3rem 280px minmax(0, 1fr);
    align-items: stretch;
    background: var(--card);
    border: 2px solid var(--edge);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 8px 8px 0 var(--edge);
    scroll-margin-top: 100px;
  }
  .spine {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    background: var(--dark);
    color: #fff;
    border-left: 2px solid var(--edge);
  }
  .spine .marker {
    font-size: 1.5rem;
  }
  .spine .mono {
    font-size: 0.7rem;
    color: var(--cyan);
  }
  .member.orange .spine .mono {
    color: var(--orange);
  }
  .photo {
    overflow: hidden;
    border-right: 2px solid var(--edge);
    position: relative;
  }
  .photo::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 12px;
    background: linear-gradient(to bottom, var(--orange) 0 50%, var(--cyan) 50%);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .text {
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }
  .side {
    color: var(--orange);
    font-weight: 700;
    font-size: 0.75rem;
  }
  h3 {
    font-family: var(--font-marker);
    font-weight: 400;
    text-transform: none;
    font-size: clamp(2.2rem, 1.8rem + 1.6vw, 3rem);
    line-height: 1.1;
    margin: 0.25rem 0 0.4rem;
  }
  .voice {
    display: inline-block;
    font-size: 0.75rem;
    background: var(--dark);
    color: var(--on-dark);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 1.25rem;
  }

  .lineup-section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .lineup {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 3px solid var(--ink);
  }
  /* Equal padding above and below each entry: the line reaches as far above the
     first dot as below the last, and each dot sits on the middle of its text. */
  .lineup li {
    position: relative;
    padding: 0.9rem 0 0.9rem 1.75rem;
    display: grid;
    gap: 0.2rem;
  }
  .lineup li::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 50%;
    translate: 0 -50%;
    width: 25px;
    height: 25px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 4px, var(--cyan) 4.5px);
    border: 3px solid var(--ink);
  }
  .lineup li:last-child::before {
    background: radial-gradient(circle, #fff 0 4px, var(--orange) 4.5px);
  }
  .period {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    line-height: 1.1;
  }

  .former-section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .former {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .member.small {
    grid-template-columns: 220px minmax(0, 1fr);
    box-shadow: 6px 6px 0 var(--edge);
  }
  .member.small .photo::after {
    display: none;
  }
  .member.small h3 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }
  /* Photo fills its column at the card's height instead of growing to a square wider than the column */
  .member.small .photo {
    aspect-ratio: auto;
    min-height: 220px;
  }
  .member.small .photo img {
    object-position: center 25%;
  }
  .member.small .prose {
    font-size: 0.95rem;
  }
  .photo.grey img {
    filter: grayscale(0.4);
  }
  .old-photo {
    margin: 3rem 0 0;
  }
  .old-photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 2px solid var(--edge);
  }
  .old-photo figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .cta-section {
    padding-block: clamp(3rem, 7vw, 5rem);
    background: var(--dark);
    color: var(--on-dark);
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta h2 {
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4.5rem);
    color: var(--cyan);
  }

  @media (max-width: 900px) {
    .intro-grid,
    .former {
      grid-template-columns: minmax(0, 1fr);
    }
    .cutout-wrap {
      margin-top: 3rem;
    }
  }
  @media (max-width: 760px) {
    .member {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }
    .spine {
      grid-row: span 2;
    }
    .photo {
      aspect-ratio: 1;
      border-right: 0;
      border-bottom: 2px solid var(--edge);
    }
    .member.small {
      grid-template-columns: 120px minmax(0, 1fr);
    }
    .member.small .photo {
      aspect-ratio: auto;
      min-height: 120px;
      border-bottom: 0;
      border-right: 2px solid var(--edge);
    }
  }
</style>
