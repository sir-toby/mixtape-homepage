---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import NextEvent from '../../components/NextEvent.astro';
import EventTrack from '../../components/EventTrack.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import CalendarSubscribe from '../../components/CalendarSubscribe.astro';
import { getEntry } from 'astro:content';
import { getEvents } from '../../lib/events';
import settings from '../../data/settings.json';

const page = (await getEntry('pages', 'termine'))!;
const t = page.data;
const { upcoming, past } = await getEvents();
const [next, ...later] = upcoming;

// Past events grouped by year, newest first.
const byYear = Object.entries(
  past.reduce<Record<string, typeof past>>((acc, e) => {
    (acc[e.data.date.getUTCFullYear()] ??= []).push(e);
    return acc;
  }, {}),
).sort(([a], [b]) => Number(b) - Number(a));
---

<Base title={t.title} description={t.description}>
  <PageHero label={t.label ?? ''} title={t.title} intro={t.intro} tone="cyan" />

  <section class="section">
    <div class="wrap">
      <h2 class="sub hand-heading">{t.upcomingHeading}</h2>
      {
        next ? (
          <>
            <NextEvent event={next} />
            {later.length > 0 && (
              <ol class="tracklist">
                {later.map((e) => (
                  <EventTrack event={e} />
                ))}
              </ol>
            )}
          </>
        ) : (
          <p class="empty">{t.emptyText}</p>
        )
      }
      <aside class="box">
        <CalendarSubscribe />
      </aside>
      <aside class="nl">
        <p><strong>{t.newsletterTitle}</strong> {t.newsletterText}</p>
        <NewsletterForm />
      </aside>
    </div>
  </section>

  {
    byYear.length > 0 && (
      <section class="section archive surface-2">
        <div class="wrap">
          <h2 class="sub hand-heading">{t.pastHeading}</h2>
          {byYear.map(([year, events]) => (
            <div class="year">
              <h3>{year}</h3>
              <ol class="tracklist">
                {events.map((e) => (
                  <EventTrack event={e} past />
                ))}
              </ol>
            </div>
          ))}
          <p class="booking">
            {t.bookingNote}{' '}
            <a href={`mailto:${settings.email}`}>{settings.email}</a>.
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .sub {
    margin: 0 0 2rem;
  }
  .tracklist {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .box {
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 2px solid var(--edge);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: 8px 8px 0 var(--edge);
  }
  .nl {
    margin-top: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 2px solid var(--edge);
    background: var(--paper-2);
    border-radius: var(--radius);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: center;
  }
  .nl p {
    margin: 0;
  }
  .archive {
  }
  .year + .year {
    margin-top: 3rem;
  }
  .year h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 2rem;
  }
  .year h3::after {
    content: '';
    flex: 1;
    height: 6px;
    background: linear-gradient(to bottom, var(--orange) 0 50%, var(--cyan) 50%);
  }
  .year .tracklist {
    margin-top: 1rem;
  }
  .booking {
    margin-top: 3rem;
  }
  .booking a {
    color: var(--cyan-deep);
    font-weight: 600;
  }
  .empty {
    font-size: 1.2rem;
  }
  @media (max-width: 760px) {
    .nl {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
