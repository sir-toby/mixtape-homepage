---
import Base from '../layouts/Base.astro';
import Cassette from '../components/Cassette.astro';
import { url } from '../lib/url';
import { getEntry } from 'astro:content';

const page = (await getEntry('pages', 'fehlerseite'))!.data;
---

<Base title={page.title} noindex>
  <section class="wrap lost">
    <div class="tape" aria-hidden="true"><Cassette side="?" type="404">Track nicht gefunden</Cassette></div>
    <h1>{page.heading}</h1>
    {page.intro && <p>{page.intro}</p>}
    <a class="btn btn--orange" href={url('/')}>Zur Startseite</a>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(4rem, 10vw, 8rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .tape {
    width: min(360px, 80vw);
    margin-bottom: 1.5rem;
    transform: rotate(-6deg);
  }
  h1 {
    font-size: clamp(4rem, 2rem + 8vw, 9rem);
  }
</style>
