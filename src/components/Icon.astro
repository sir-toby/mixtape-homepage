---
// Small inline icon set (stroke icons, 24px grid).
interface Props {
  name: 'instagram' | 'mail' | 'arrow' | 'arrow-up-right' | 'calendar' | 'pin' | 'clock' | 'menu' | 'close' | 'download' | 'play' | 'rec';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  download: '<path d="M12 4v11m-5-5 5 5 5-5M5 20h14"/>',
  play: '<path d="M7 4.5v15l12-7.5z" fill="currentColor"/>',
  rec: '<circle cx="12" cy="12" r="7" fill="currentColor"/>',
};
---

<svg
  class:list={[`i-${name}`, className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
