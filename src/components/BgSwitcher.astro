---
// Temporary: compare the cyan/orange blocks with and without texture on every page.
// Visible once ?flaechen=muster or ?flaechen=glatt has been used.
const options = [
  ['glatt', 'Glatt'],
  ['muster', 'Mit Muster'],
];
---

<div class="bg-switch" aria-label="Farbflächen testen">
  <span class="mono">Farbflächen</span>
  {options.map(([key, label]) => <a href={`?flaechen=${key}`} data-bg-option={key}>{label}</a>)}
</div>

<style>
  .bg-switch {
    display: none;
    position: fixed;
    left: 12px;
    bottom: 12px;
    z-index: 90;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.45rem 0.35rem 0.8rem;
    background: var(--ink);
    color: #fff;
    border-radius: 999px;
    box-shadow: 0 6px 20px #0005;
    font-size: 0.85rem;
  }
  :global(html[data-flaechen]) .bg-switch {
    display: flex;
  }
  .mono {
    font-size: 0.65rem;
    margin-right: 0.3rem;
    color: #aab;
  }
  a {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
  }
  a:hover {
    background: #ffffff22;
  }
  :global(html[data-flaechen='glatt']) a[data-bg-option='glatt'],
  :global(html[data-flaechen='muster']) a[data-bg-option='muster'] {
    background: var(--orange);
  }
</style>
