---
import CassetteOutline from './CassetteOutline.astro';
import { hyphenate } from '../lib/hyphenate';

interface Props {
  label: string;
  title: string;
  intro?: string;
  tone?: 'cyan' | 'orange' | 'paper';
}
const { label, title, intro, tone = 'paper' } = Astro.props;
---

<section class:list={['page-hero', tone]}>
  <CassetteOutline class="shape" />
  <div class="wrap inner">
    <span class="side-tag">{label}</span>
    <h1>{hyphenate(title)}</h1>
    {intro && <p class="intro">{intro}</p>}
    <slot />
  </div>
</section>
<div class="stripe-band" aria-hidden="true"></div>

<style>
  .page-hero {
    position: relative;
    /* Page headers stay plain, without the background texture */
    background: var(--paper);
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem);
  }
  .page-hero :global(.shape) {
    position: absolute;
    right: -6%;
    top: 50%;
    width: min(620px, 70vw);
    height: auto;
    color: #16171b14;
    transform: translateY(-50%) rotate(-8deg);
  }
  .cyan {
    background: var(--cyan);
  }
  .orange {
    background: var(--orange);
  }
  .cyan :global(.shape),
  .orange :global(.shape) {
    color: #16171b1f;
  }
  .cyan .side-tag,
  .orange .side-tag {
    color: var(--ink);
  }
  .orange .intro {
    color: #fff;
  }
  .inner {
    position: relative;
  }
  h1 {
    font-size: clamp(3.5rem, 1.5rem + 8vw, 9rem);
    margin-top: 0.75rem;
    padding-top: 0.08em;
    overflow-wrap: break-word;
    hyphens: manual;
  }
  .intro {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    max-width: 48ch;
    margin: 1.25rem 0 0;
  }
</style>
