---
// The double reel from the Mixtape logo (cyan above, orange below, joined by the tape).
interface Props {
  class?: string;
  muted?: boolean;
}
const { class: className, muted = false } = Astro.props;
const cogs = (cy: number) =>
  Array.from({ length: 8 }, (_, i) => {
    const a = (i * Math.PI) / 4;
    return { cx: 81 + Math.cos(a) * 27, cy: cy + Math.sin(a) * 27 };
  });
---

<svg class:list={['logo-reels', { muted }, className]} viewBox="0 60 190 370" aria-hidden="true">
  <circle class="top" cx="92" cy="157" r="83"></circle>
  <circle class="bottom" cx="92" cy="340" r="83"></circle>
  <rect x="44" y="108" width="76" height="290" rx="38" fill="#16171b"></rect>
  <rect x="52" y="198" width="36" height="108" fill="#fff" stroke="#16171b" stroke-width="6"></rect>
  {
    [150, 355].map((cy) => (
      <g>
        <circle cx="81" cy={cy} r="29" fill="#fff" />
        {cogs(cy).map((c) => (
          <circle cx={c.cx} cy={c.cy} r="5" fill="#16171b" />
        ))}
      </g>
    ))
  }
</svg>

<style>
  .top {
    fill: var(--cyan);
  }
  .bottom {
    fill: var(--orange);
  }
  .muted .top {
    fill: #9fb3bb;
  }
  .muted .bottom {
    fill: #c9b1a6;
  }
</style>
