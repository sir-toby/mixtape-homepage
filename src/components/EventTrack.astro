---
// One event as a row in a cassette-style tracklist.
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { formatDay, formatMonth, formatWeekday, formatYear, formatTime, type Event } from '../lib/events';

interface Props {
  event: Event;
  index: number;
  past?: boolean;
}
const { event, index, past = false } = Astro.props;
const { data } = event;
---

<li class:list={['track', { past }]}>
  <a href={url(`/events/${event.id}/`)}>
    <span class="no mono">{String(index).padStart(2, '0')}</span>
    <span class="date">
      <span class="wd mono">{formatWeekday(data.date)}</span>
      <span class="d">{formatDay(data.date)}</span>
      <span class="m mono">{formatMonth(data.date)} {formatYear(data.date)}</span>
    </span>
    <span class="body">
      <span class="title">{data.title}</span>
      <span class="meta">
        <span><Icon name="clock" size={15} /> {formatTime(event)}</span>
        {data.location && <span><Icon name="pin" size={15} /> {data.location}</span>}
        {data.private && <span class="tag mono">Privat</span>}
      </span>
    </span>
    <span class="go" aria-hidden="true"><Icon name="arrow" size={22} /></span>
  </a>
</li>

<style>
  .track {
    border-top: 1px solid var(--line);
  }
  .track:last-child {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 2.5rem 5.5rem 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0.75rem;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background 0.2s,
      padding 0.2s;
  }
  a:hover {
    background: var(--paper-2);
    padding-inline: 1.25rem;
  }
  .no {
    color: var(--orange);
    font-weight: 700;
  }
  /* Weekday above the day, month and year below: SO / 02 / AUG 2026 */
  .date {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.1;
  }
  .d {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
  }
  .wd,
  .m {
    font-size: 0.7rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .title {
    display: block;
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.25;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.3rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .tag {
    background: var(--paper-2);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.65rem;
  }
  .go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    transition:
      background 0.2s,
      color 0.2s,
      transform 0.2s;
  }
  a:hover .go {
    background: var(--orange);
    border-color: var(--orange);
    color: #fff;
    transform: rotate(-45deg);
  }
  .past .title {
    font-weight: 600;
  }
  .past .no {
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    a {
      grid-template-columns: 4.25rem minmax(0, 1fr);
      gap: 0.25rem 1rem;
      padding-inline: 0.25rem;
      align-items: start;
    }
    .d {
      font-size: 2.3rem;
    }
    a:hover {
      padding-inline: 0.5rem;
    }
    .no,
    .go {
      display: none;
    }
  }
</style>
