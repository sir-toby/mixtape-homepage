---
import Logo from '../assets/brand/logo-light.svg';
import settings from '../data/settings.json';
import Icon from './Icon.astro';
import Reel from './Reel.astro';
import { url } from '../lib/url';
import { getEntry } from 'astro:content';

const { tagline } = (await getEntry('pages', 'home'))!.data;
---

<div class="stripe-band" aria-hidden="true"></div>
<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo class="logo" role="img" aria-label="Mixtape" />
      {tagline && <p>{tagline}</p>}
    </div>
    <nav aria-label="Seiten">
      <span class="mono head">Seiten</span>
      <a href={url('/events/')}>Termine</a>
      <a href={url('/wer-wir-sind/')}>Über uns</a>
      <a href={url('/newsletter/')}>Newsletter</a>
    </nav>
    <nav aria-label="Kontakt">
      <span class="mono head">Kontakt</span>
      <a href={`mailto:${settings.email}`}><Icon name="mail" size={18} /> {settings.email}</a>
      <a href={settings.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> @mixtape_acappella</a>
    </nav>
    <div class="reels" aria-hidden="true">
      <Reel size={64} color="var(--cyan)" hub="var(--dark)" />
      <Reel size={64} color="var(--orange)" hub="var(--dark)" speed="7s" />
    </div>
  </div>
  <div class="wrap legal">
    <span>© {new Date().getFullYear()} Mixtape Vocal GbR</span>
    <span class="links">
      <a href={url('/impressum/')}>Impressum</a>
      <a href={url('/datenschutzerklaerung/')}>Datenschutz&shy;erklärung</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: #e9e4da;
    padding-block: clamp(3rem, 6vw, 5rem) 1.5rem;
    margin-top: auto;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr auto;
    gap: 2.5rem;
    align-items: start;
  }
  .brand :global(.logo) {
    display: block;
    width: 200px;
    height: auto;
    margin-bottom: 1rem;
  }
  .brand p {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
    color: var(--cyan);
    max-width: 14ch;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .head {
    color: #9aa0a8;
    margin-bottom: 0.3rem;
  }
  nav a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    overflow-wrap: anywhere;
  }
  nav a:hover {
    color: var(--orange);
  }
  .reels {
    display: flex;
    gap: 0.75rem;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #ffffff1f;
    font-size: 0.875rem;
    color: #9aa0a8;
  }
  .links {
    display: flex;
    gap: 1.5rem;
  }
  .legal a:hover {
    color: #fff;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .reels {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
