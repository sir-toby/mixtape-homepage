---
// A compact cassette drawn in SVG. The label area takes HTML via the default slot.
// With `interactive`, the reels turn while the page scrolls and the tape winds
// from the left reel to the right one as you read down the page.
interface Props {
  shell?: string;
  label?: string;
  side?: string;
  type?: string;
  interactive?: boolean;
  class?: string;
}
const { shell = 'var(--ink)', label = '#fff', side = 'A', type = 'C60', interactive = false, class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
// Hub: the gear from the Mixtape logo.
const GEAR =
  'M39.86059904337854,167.80708728671218 A47.0,47.0 0 1 0 133.86059904337856,167.80708728671218 A47.0,47.0 0 1 0 39.86059904337854,167.80708728671218 Z M 85.994141,132.04102 c 4.973202,0.006 9.919147,1.08527 14.499999,3.14062 c -0.84354,1.25418 -1.901152,3.05698 -2.072265,3.43945 c -0.3546,0.67867 -0.692713,2.33298 -0.320313,3.51953 c 0.180711,0.6046 1.911658,2.83074 3.427738,2.86524 c 1.03971,-0.14674 2.82812,-1.94318 2.9375,-2.29102 c 0.17521,-0.33238 1.066,-2.00977 1.83398,-3.32226 c 0.12979,-0.32521 0.28166,-0.50973 0.44336,-0.625 c 3.82266,2.73545 7.19729,6.26885 9.85547,10.54101 c 1.11492,1.79188 2.04851,3.64183 2.82422,5.52539 c -0.59105,0.709 -1.94099,0.28012 -3.31055,0.86524 c -1.81578,0.55339 -4.43991,1.97556 -3.55273,4.0625 c 0.3183,1.22561 1.07531,1.81287 2.03515,2.10351 c 1.87974,0.29961 4.14914,-0.55281 6.02735,-0.51171 c 0.28605,0.0186 0.5747,0.1268 0.85742,0.27734 c 1.41808,7.12713 0.65475,14.42132 -2.07617,20.91211 c -0.23983,-0.11391 -0.47662,-0.24546 -0.69727,-0.35938 c -1.51935,-0.74232 -2.4021,-1.14317 -3.76758,-2.01953 c -1.0529,-0.76757 -1.83535,-1.25823 -3.19922,-0.33789 c -1.44756,0.86064 -1.94214,2.04024 -1.38867,3.55664 c 0.74934,1.36746 2.15172,2.09442 3.28906,2.87696 c 1.06844,0.61546 1.88017,1.00743 2.73438,1.73828 c 0.0332,0.0206 0.0592,0.0487 0.0898,0.0723 c -2.65601,4.06294 -6.1959,7.61583 -10.56445,10.33399 c -1.79905,1.11938 -3.66562,2.04043 -5.57227,2.79101 c -0.605345,-1.00264 -1.038902,-2.28314 -1.332026,-3.1875 c -0.4779,-1.05339 -1.150508,-3.08766 -2.580078,-3.61719 c -1.07362,-0.71424 -2.8966,-1.54797 -3.84961,0.082 c -1.61078,1.2509 -0.498153,3.88642 -0.439453,5.5625 c 0.38869,1.11316 0.52346,1.92922 -0.207031,2.64062 c -0.342232,0.28852 -0.711335,0.5406 -1.097656,0.76367 c -5.972131,0.527 -12.00747,-0.51187 -17.517578,-2.9707 c -0.12067,-0.78383 -0.08781,-1.57729 0.0293,-2.16016 c 0.70822,-1.77006 1.293642,-3.37618 1.669922,-5.07226 c 0.452,-1.04655 -0.433845,-2.16017 -1.421875,-2.28711 c -1.2859,-0.76021 -2.777223,-0.57932 -4.314453,0.5039 c -1.12138,1.62216 -2.183385,3.40588 -2.515625,5.20118 c -0.0022,0.006 -0.00749999999999,0.0133 -0.0098,0.0195 c -3.722024,-2.71055 -7.01199,-6.1806 -9.613282,-10.36133 c -1.305865,-2.09875 -2.373298,-4.27428 -3.214844,-6.49414 c 0.846416,-0.24402 1.795876,-0.17857 2.691407,-0.32422 c 1.53462,-0.12363 3.06597,-1.07879 3.58789,-2.00781 c 0.90392,-1.31608 -0.638047,-3.75248 -1.898437,-4.19922 c -1.360979,-0.20825 -2.849408,0.0589 -4.335938,0.25391 c -0.748863,-0.0236 -1.36748,-0.28305 -1.923828,-0.66016 c -1.075887,-6.44659 -0.373749,-12.98908 1.929688,-18.91211 c 0.893902,0.14696 1.753221,0.35295 2.648437,0.63867 c 1.41059,0.79255 3.579221,1.50495 5.207031,-0.0488 c 1.51687,-0.7449 1.369645,-2.61103 0.328126,-3.98242 c -1.175697,-1.50851 -2.986094,-2.38406 -4.248047,-3.9707 c 2.576595,-3.66905 5.902751,-6.88308 9.929687,-9.38867 c 1.615302,-1.00506 3.284458,-1.85321 4.988281,-2.56055 c 0.588029,0.26305 1.10092,0.68996 1.417969,1.1582 c 1.23897,1.97421 1.743496,3.73147 3.291016,4.39063 c 0.8715,0.0488 1.831047,0.12759 2.873047,-0.33985 c 0.79205,-1.05596 0.271525,-2.51295 0.203125,-3.77148 c -0.112329,-1.19239 -0.26289,-2.54592 0.164062,-3.6582 c 1.735435,-0.26368 3.482521,-0.39652 5.226563,-0.39453 z';
---

<div class:list={['cassette', className]} style={`--shell:${shell};--label:${label}`} data-cassette={interactive ? '' : undefined}>
  <svg viewBox="0 0 1000 640" aria-hidden="true">
    <defs>
      <clipPath id={`win-${uid}`}><rect x="290" y="250" width="420" height="140" rx="20"></rect></clipPath>
      <linearGradient id={`glare-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity=".22"></stop>
        <stop offset=".5" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
    </defs>
    <rect width="1000" height="640" rx="40" fill="var(--shell)"></rect>
    <rect x="14" y="14" width="972" height="612" rx="30" fill="none" stroke="#fff" stroke-opacity=".12" stroke-width="3"></rect>
    <rect x="70" y="56" width="860" height="404" rx="20" fill="var(--label)"></rect>
    <rect x="70" y="384" width="860" height="24" fill="var(--orange)"></rect>
    <rect x="70" y="408" width="860" height="24" fill="var(--cyan)"></rect>
    <rect x="270" y="230" width="460" height="180" rx="34" fill="var(--shell)"></rect>
    <rect x="290" y="250" width="420" height="140" rx="20" fill="#0d0f13"></rect>
    <g clip-path={`url(#win-${uid})`}>
      <circle class="tape tape-l" cx="390" cy="320" r="110" fill="#4a3426"></circle>
      <circle class="tape tape-r" cx="610" cy="320" r="110" fill="#4a3426"></circle>
      <rect x="290" y="250" width="420" height="140" fill={`url(#glare-${uid})`}></rect>
    </g>
    {
      [390, 610].map((cx) => (
        <g class="hub" style={`transform-origin:${cx}px 320px`}>
          <path d={GEAR} fill="#f4f4f4" fill-rule="evenodd" transform={`translate(${cx} 320) scale(0.8) translate(-86.86 -167.81)`} />
        </g>
      ))
    }
    <path d="M190 640 L240 500 H760 L810 640 Z" fill="#000" fill-opacity=".22"></path>
    <circle cx="330" cy="585" r="20" fill="#0d0f13"></circle>
    <circle cx="670" cy="585" r="20" fill="#0d0f13"></circle>
    <rect x="425" y="570" width="30" height="30" rx="4" fill="#0d0f13"></rect>
    <rect x="545" y="570" width="30" height="30" rx="4" fill="#0d0f13"></rect>
    {
      [
        [40, 40],
        [960, 40],
        [40, 600],
        [960, 600],
        [500, 535],
      ].map(([x, y]) => (
        <g>
          <circle cx={x} cy={y} r="13" fill="#000" fill-opacity=".35" />
          <path d={`M${x - 7} ${y} H${x + 7}`} stroke="#fff" stroke-opacity=".35" stroke-width="3" />
        </g>
      ))
    }
  </svg>
  <div class="label-area">
    <span class="side">{side}</span>
    <div class="writing"><slot /></div>
    <span class="type">{type}</span>
  </div>
</div>

<script>
  // One loop for every interactive cassette on the page.
  const tapes = [...document.querySelectorAll<HTMLElement>('[data-cassette]')];
  if (tapes.length) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let angle = 0;
    let lastY = scrollY;
    let speed = 0;
    const progress = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      return max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    };
    const frame = () => {
      const p = progress();
      speed = speed * 0.9 + Math.abs(scrollY - lastY) * 0.6;
      lastY = scrollY;
      angle = (angle + (still ? 0 : 0.6 + speed)) % 360;
      for (const t of tapes) {
        t.style.setProperty('--p', p.toFixed(4));
        t.style.setProperty('--angle', `${angle}deg`);
      }
      if (!still) requestAnimationFrame(frame);
    };
    frame();
    if (still) addEventListener('scroll', frame, { passive: true });
  }
</script>

<style>
  .cassette {
    /* A physical object: label writing stays dark in dark mode */
    --ink: #16171b;
    --ink-soft: #3d434d;
    --p: 0.25;
    --angle: 0deg;
    position: relative;
    container-type: inline-size;
    aspect-ratio: 1000 / 640;
    filter: drop-shadow(0 24px 30px #16171b40);
  }
  svg {
    width: 100%;
    height: 100%;
  }
  .tape {
    transform-box: fill-box;
    transform-origin: center;
  }
  .tape-l {
    transform: scale(calc(0.42 + 0.58 * (1 - var(--p))));
  }
  .tape-r {
    transform: scale(calc(0.42 + 0.58 * var(--p)));
  }
  .hub {
    transform: rotate(var(--angle));
  }
  .cassette:not([data-cassette]) .hub {
    animation: spin 6s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .label-area {
    position: absolute;
    left: 7%;
    right: 7%;
    top: 8.75%;
    height: 26%;
    display: flex;
    align-items: center;
    gap: 3cqw;
    padding-inline: 3cqw;
  }
  .side {
    flex: none;
    display: grid;
    place-items: center;
    width: 9cqw;
    height: 9cqw;
    border-radius: 1.5cqw;
    background: var(--ink);
    color: #fff;
    font: 800 6.5cqw/1 var(--font-display);
  }
  .writing {
    flex: 1;
    min-width: 0;
    border-bottom: 0.35cqw solid #16171b33;
    font-family: 'Permanent Marker', var(--font-display);
    font-size: 5.4cqw;
    line-height: 1.25;
    color: var(--ink);
    text-align: center;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
  .type {
    flex: none;
    font: 700 3cqw/1 var(--font-mono);
    color: var(--ink-soft);
  }
</style>
